  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      function signedIn() {
        return request.auth != null;
      }

      // Pre-claims accounts only: the users/{uid}.role mirror the backend writes next to the claim.
      function mirrorRole() {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        return exists(path) ? get(path).data.get('role', null) : null;
      }

      // The custom claim is the source of truth (docs/auth-contract.md section 2). The mirror is
      // read only for accounts that have no claim yet; migrate-roles.js gives them one.
      function role() {
        return !signedIn() ? null :
          ('role' in request.auth.token ? request.auth.token.role : mirrorRole());
      }

      function isLecturer() {
        return role() == 'lecturer';
      }

      // Super admins get read-only oversight of grading across all groups — they audit how
      // lecturers grade/override, but never write grades or content. 'admin' is the pre-claims
      // name; migrate-roles.js rewrites it to 'superAdmin'.
      function isAdmin() {
        return role() in ['superAdmin', 'admin'];
      }

      function groupData(groupId) {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      function isMemberOfGroup(groupId) {
        let g = groupData(groupId);
        return g != null &&
          (request.auth.uid in g.memberIds || request.auth.uid in g.lecturerIds);
      }

      // A student member: the only people who write workspace content.
      function isStudentMemberOfGroup(groupId) {
        let g = groupData(groupId);
        return signedIn() && g != null && request.auth.uid in g.memberIds && !isLecturer();
      }

      // Set by the server deadline job (backend/src/jobs/deadlines) once the deadline passes.
      // A locked workspace is read-only for everyone using the client SDK.
      function groupLocked(groupId) {
        let g = groupData(groupId);
        return g != null && g.get('locked', false) == true;
      }

      // Fields only the backend (Admin SDK) may write on a group.
      function serverOnlyGroupFields() {
        return ['locked', 'lockedAt', 'lockedBy', 'lockedDeadline', 'autoSubmit', 'extendedDeadline', 'extension'];
      }

      function touchesServerOnlyGroupFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyGroupFields());
      }

      // submittedToLecturers is how a student hands the workspace to a lecturer. Only student
      // members change it, and only by adding: a lecturer can't unlock a workspace for
      // themselves, and a student can't take back work after submitting it.
      function submittedToLecturersChangeAllowed() {
        let was = resource.data.get('submittedToLecturers', []);
        let now = request.resource.data.get('submittedToLecturers', []);
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['submittedToLecturers']) || (
          request.auth.uid in resource.data.memberIds && !isLecturer() && now.hasAll(was)
        );
      }

      function isLecturerOfGroup(groupId) {
        let g = groupData(groupId);
        return g != null && request.auth.uid in g.lecturerIds;
      }

      // True when a student has submitted work to this lecturer on this group.
      // createWorkspaceSubmission() adds the lecturer uid via arrayUnion(submittedToLecturers).
      function submissionUnlockedForLecturer(groupId) {
        let g = groupData(groupId);
        return g != null &&
          isLecturer() &&
          g.lecturerIds != null &&
          request.auth.uid in g.lecturerIds &&
          g.submittedToLecturers != null &&
          request.auth.uid in g.submittedToLecturers;
      }

      // Students: full workspace access. Lecturers: only after submission unlock.
      function canReadWorkspaceContent(groupId) {
        let g = groupData(groupId);
        return g != null && (
          (g.memberIds != null && request.auth.uid in g.memberIds && !isLecturer()) ||
          submissionUnlockedForLecturer(groupId)
        );
      }

      // A submitted file (files/{fileId}.submitted) and its document body are read-only.
      function fileSubmitted(groupId, fileId) {
        let path = /databases/$(database)/documents/groups/$(groupId)/files/$(fileId);
        return exists(path) && get(path).data.get('submitted', false) == true;
      }

      // ——— Users (profiles) ———
      match /users/{userId} {
        allow read: if signedIn();
        // `role` mirrors the custom claim and only the backend (Admin SDK) writes it, so a
        // client can neither create a profile with a role nor change or remove it later.
        allow create: if signedIn() && request.auth.uid == userId &&
          !('role' in request.resource.data);
        // Own updates may change any field except role. Any signed-in user may set only the groupId field,
        // and only to a group they are themselves a member/lecturer of — this is the
        // invite flow (addGroupMember sets the invited user's groupId pointer; the inviter
        // is always an existing member of that group).
        allow update: if signedIn() && (
          (request.auth.uid == userId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId']) &&
            isMemberOfGroup(request.resource.data.groupId)
          )
        );
        allow delete: if false;

        match /notifications/{notificationId} {
          allow read, update: if signedIn() && request.auth.uid == userId;
          allow create: if signedIn();
          // The owner may dismiss (delete) their own notifications.
          allow delete: if signedIn() && request.auth.uid == userId;
        }

        // Push tokens, one document per device (id = the FCM token). Only the owner reads or
        // writes them; the notifier reads them with the Admin SDK.
        match /fcmTokens/{tokenId} {
          allow read, write: if signedIn() && request.auth.uid == userId;
        }
      }

      // ——— Projects / Groups ———
      // Use resource.data directly for the group document read — avoids a circular
      // get() call on the same document that isMemberOfGroup() would produce,
      // which silently breaks onSnapshot list queries (Bugs 2 & 3).
      match /groups/{groupId} {
        allow read: if signedIn() && (
          request.auth.uid in resource.data.memberIds ||
          request.auth.uid in resource.data.lecturerIds ||
          isAdmin()
        );
        // The creator must be in the group, nothing starts submitted, and the lock fields are
        // the server's.
        allow create: if signedIn() &&
          (request.auth.uid in request.resource.data.memberIds ||
            request.auth.uid in request.resource.data.lecturerIds) &&
          request.resource.data.get('submittedToLecturers', []).size() == 0 &&
          !request.resource.data.keys().hasAny(serverOnlyGroupFields());
        // Only members update a group. Members may add lecturers (invites, "submit to a
        // lecturer"), but see submittedToLecturersChangeAllowed for the unlock itself.
        allow update: if signedIn() &&
          (request.auth.uid in resource.data.memberIds || request.auth.uid in resource.data.lecturerIds) &&
          !touchesServerOnlyGroupFields() &&
          submittedToLecturersChangeAllowed();
        // Use resource.data directly to avoid a circular get() on the same doc being deleted.
        // Any member may delete the workspace until it is locked at the deadline.
        allow delete: if signedIn() &&
          (request.auth.uid in resource.data.memberIds || request.auth.uid in resource.data.lecturerIds) &&
          resource.data.get('locked', false) != true;

        match /folders/{folderId} {
          allow read: if canReadWorkspaceContent(groupId);
          allow create, update, delete: if isStudentMemberOfGroup(groupId) && !groupLocked(groupId);
        }

        match /files/{fileId} {
          allow read: if canReadWorkspaceContent(groupId);
          allow create: if isStudentMemberOfGroup(groupId) && !groupLocked(groupId);
          // Marking a file submitted is its last client write.
          allow update, delete: if isStudentMemberOfGroup(groupId) && !groupLocked(groupId) &&
            resource.data.get('submitted', false) != true;
        }

        // Version history is append-only.
        match /versions/{versionId} {
          allow read: if canReadWorkspaceContent(groupId);
          allow create: if isStudentMemberOfGroup(groupId) && !groupLocked(groupId);
          allow update, delete: if false;
        }

        match /activity/{activityId} {
          allow read: if canReadWorkspaceContent(groupId);
          allow create, update: if isStudentMemberOfGroup(groupId);
          allow delete: if isLecturerOfGroup(groupId);
        }

        match /pasteEvents/{eventId} {
          // Student members may read their workspace's paste events (needed so the submit
          // flow can attach them to the report); lecturers read after submission unlock.
          allow read: if isStudentMemberOfGroup(groupId) ||
            (canReadWorkspaceContent(groupId) && isLecturerOfGroup(groupId));
          allow create: if isStudentMemberOfGroup(groupId) && !groupLocked(groupId);
          allow update, delete: if false;
        }

        // The current grade per member. Every change that differs from the suggested grade is
        // also appended to overrides/ (who, when, why).
        match /grades/{gradeId} {
          allow read: if isAdmin() ||
            (isMemberOfGroup(groupId) && (canReadWorkspaceContent(groupId) || !isLecturer()));
          allow create, update: if submissionUnlockedForLecturer(groupId) &&
            request.resource.data.lecturerId == request.auth.uid;
          allow delete: if submissionUnlockedForLecturer(groupId);
        }

        // Lecturer overrides: a separate, append-only log. Nobody edits or removes an entry.
        match /overrides/{overrideId} {
          allow read: if isAdmin() ||
            (isMemberOfGroup(groupId) && (canReadWorkspaceContent(groupId) || !isLecturer()));
          allow create: if submissionUnlockedForLecturer(groupId) &&
            request.resource.data.keys().hasOnly(['memberId', 'grade', 'suggestedGrade', 'reason', 'lecturerId', 'lecturerName', 'createdAt']) &&
            request.resource.data.lecturerId == request.auth.uid &&
            request.resource.data.memberId is string &&
            request.resource.data.grade is number &&
            request.resource.data.grade >= 0 && request.resource.data.grade <= 10 &&
            request.resource.data.reason is string &&
            request.resource.data.reason.trim().size() > 0 &&
            request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        // Inline feedback (step 4.6): a lecturer's comment anchored to the text of a submitted
        // file. The group reads it; only its author edits the comment or deletes it.
        match /feedback/{feedbackId} {
          allow read: if canReadWorkspaceContent(groupId);
          allow create: if submissionUnlockedForLecturer(groupId) &&
            request.resource.data.keys().hasOnly(['fileId', 'quote', 'comment', 'lecturerId', 'lecturerName', 'createdAt']) &&
            request.resource.data.lecturerId == request.auth.uid &&
            request.resource.data.fileId is string &&
            fileSubmitted(groupId, request.resource.data.fileId) &&
            request.resource.data.quote.keys().hasOnly(['exact', 'prefix', 'suffix']) &&
            request.resource.data.quote.exact is string &&
            request.resource.data.quote.exact.size() > 0 && request.resource.data.quote.exact.size() <= 1000 &&
            request.resource.data.quote.prefix is string && request.resource.data.quote.prefix.size() <= 64 &&
            request.resource.data.quote.suffix is string && request.resource.data.quote.suffix.size() <= 64 &&
            request.resource.data.comment is string &&
            request.resource.data.comment.trim().size() > 0 && request.resource.data.comment.size() <= 2000 &&
            request.resource.data.createdAt == request.time;
          allow update: if submissionUnlockedForLecturer(groupId) &&
            resource.data.lecturerId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment']) &&
            request.resource.data.comment is string &&
            request.resource.data.comment.trim().size() > 0 && request.resource.data.comment.size() <= 2000;
          allow delete: if submissionUnlockedForLecturer(groupId) && resource.data.lecturerId == request.auth.uid;
        }

        match /notifications/{notificationId} {
          allow read: if isMemberOfGroup(groupId);
          allow create: if isMemberOfGroup(groupId);
          allow update: if isMemberOfGroup(groupId);
          // A lecturer of the group, or the recipient the notification targets, may delete it.
          allow delete: if isLecturerOfGroup(groupId) || (
            isMemberOfGroup(groupId) && (
              resource.data.targetUserId == request.auth.uid ||
              resource.data.userId == request.auth.uid ||
              resource.data.lecturerId == request.auth.uid
            )
          );
        }

        match /presence/{userId} {
          allow read: if isMemberOfGroup(groupId);
          allow create, update, delete: if signedIn() && request.auth.uid == userId && isMemberOfGroup(groupId);
        }
      }

      // Analytics: any group member can read (lecturers see aggregated metrics; file content
      // is still gated by the files/folders rules). Students and lecturers can update their own entry.
      match /analytics/{groupId}/members/{memberId} {
        allow read: if signedIn() && isMemberOfGroup(groupId);
        allow create: if signedIn() && isMemberOfGroup(groupId);
        allow update: if signedIn() &&
          (request.auth.uid == memberId || isLecturerOfGroup(groupId));
        allow delete: if isLecturerOfGroup(groupId);
      }

      // Document content (the actual workspace text, keyed by fileId). Each doc stores
      // groupId, so gate it exactly like workspace content: members read freely,
      // lecturers only after submission unlock. Only student members may write, never after
      // the file is submitted, and a body can't be moved to another group.
      match /documents/{docId} {
        allow read: if signedIn() &&
          resource.data.groupId != null &&
          canReadWorkspaceContent(resource.data.groupId);
        allow create: if request.resource.data.groupId is string &&
          isStudentMemberOfGroup(request.resource.data.groupId) &&
          !groupLocked(request.resource.data.groupId) &&
          !fileSubmitted(request.resource.data.groupId, docId);
        allow update: if isStudentMemberOfGroup(resource.data.groupId) &&
          request.resource.data.groupId == resource.data.groupId &&
          !groupLocked(resource.data.groupId) &&
          !fileSubmitted(resource.data.groupId, docId);
        allow delete: if isStudentMemberOfGroup(resource.data.groupId) &&
          !groupLocked(resource.data.groupId) &&
          !fileSubmitted(resource.data.groupId, docId);
      }

      // Reports hold the analysis results of a submission and are create-once: written by the
      // submitting student (or the server job with the Admin SDK), then never changed or removed.
      // A lecturer querying by groupId will only see reports for groups they are in.
      match /reports/{reportId} {
        allow read: if signedIn() && (
          resource.data.groupId == null ||
          (isMemberOfGroup(resource.data.groupId) &&
            (!isLecturer() || submissionUnlockedForLecturer(resource.data.groupId)))
        );
        allow create: if signedIn() &&
          request.resource.data.groupId is string &&
          request.resource.data.userId == request.auth.uid &&
          isMemberOfGroup(request.resource.data.groupId) &&
          !groupLocked(request.resource.data.groupId);
        allow update, delete: if false;
      }

      // Who did what, when and why (deadline extensions, step 4.6). Written by the backend
      // only, until the PostgreSQL audit_log takes over.
      match /auditLog/{entryId} {
        allow read, write: if false;
      }

      // Yjs state of each live document. Only the collab server (Admin SDK) reads or writes it;
      // clients get the document through the collab server, which checks membership itself.
      match /collabDocs/{docName} {
        allow read, write: if false;
      }

      match /submissions/{submissionId} {
        allow read: if signedIn() && (
          resource.data.submittedBy == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.lecturerId == request.auth.uid ||
          (resource.data.workspaceId != null &&
            isMemberOfGroup(resource.data.workspaceId) &&
            canReadWorkspaceContent(resource.data.workspaceId))
        );
        // A submission may only be created/updated by its own author (the student who
        // submitted) and only for a workspace they belong to. Two write shapes exist:
        // saveSubmissionReport keys by userId; saveFullSubmission keys by submittedBy.
        allow create: if signedIn() &&
          (request.resource.data.workspaceId != null
            ? isMemberOfGroup(request.resource.data.workspaceId) && !groupLocked(request.resource.data.workspaceId)
            : isMemberOfGroup(request.resource.data.groupId) && !groupLocked(request.resource.data.groupId)) &&
          (request.resource.data.submittedBy == request.auth.uid ||
            request.resource.data.userId == request.auth.uid);
        allow update: if signedIn() && (
          resource.data.submittedBy == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          // Lecturers reviewing a submission flip its status (reviewedAt/status only).
          resource.data.lecturerId == request.auth.uid
        );
        // The assigned lecturer (or a lecturer of the submission's workspace) may delete it.
        allow delete: if signedIn() && (
          resource.data.lecturerId == request.auth.uid ||
          (resource.data.workspaceId != null && isLecturerOfGroup(resource.data.workspaceId))
        );
      }
    }
  }
