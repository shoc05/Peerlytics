{
  "name": "peerlytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks",
    "dev:server": "node backend/server.js",
    "lint": "eslint src --ext .js,.jsx",
    "test": "node --test src/**/*.test.js .github/scripts/*.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-peerlytics \"node --test test/firestore.rules.test.js\"",
    "test:auth": "firebase emulators:exec --only auth,firestore --project demo-peerlytics \"node --test backend/src/auth/auth.emulator.itest.js\"",
    "test:deadlines": "firebase emulators:exec --only firestore --project demo-peerlytics \"node --test backend/src/jobs/deadlines/deadlines.emulator.itest.js\""
  },
  "dependencies": {
    "@hocuspocus/provider": "^2.15.3",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-collaboration": "^2.27.3",
    "@tiptap/extension-collaboration-cursor": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-text-align": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "firebase": "^10.14.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.4",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^4.4.0"
  }
}
