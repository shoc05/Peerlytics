# Copy to .env at the repo root. One file serves the frontend (VITE_*) and backend/.
# Never commit .env or a service-account key.

# ── Frontend (Vite) — Firebase web config from the Firebase console ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Backend base URL. Leave empty in dev (Vite proxies /api to :5000).
VITE_API_URL=
# Collab server WebSocket URL for live editing (yjs_enabled), e.g. ws://localhost:1234.
# Empty: live editing stays off and the old Firestore sync is used.
VITE_COLLAB_URL=

# ── Backend ──
PORT=5000
# Comma-separated browser-origin allow-list; for local development, use http://localhost:3000.
# Leave empty to allow no cross-origin browser requests; do not use *.
CORS_ORIGIN=
# Admin SDK service account: a path (relative to backend/) or the JSON itself.
# Needed for /api/auth/* (roles), the server deadline lock and the reminder emails.
FIREBASE_SERVICE_ACCOUNT=
# Time zone for deadlines stored without one (datetime-local), e.g. Asia/Thimphu.
DEADLINE_TIMEZONE=Asia/Thimphu
# Needed for /api/auth/* (roles) and the reminder emails.
FIREBASE_SERVICE_ACCOUNT=

# Analysis providers
HF_API_KEY=
HF_AI_MODEL=
VWT_API_KEY=

# Deadline reminder emails (optional; dormant without SMTP_USER/SMTP_PASS)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=
REMINDER_WINDOW_HOURS=24
REMINDER_OFFLINE_SECONDS=300
REMINDER_CRON=*/15 * * * *

# ── Collab server (collab/) — also uses FIREBASE_SERVICE_ACCOUNT ──
COLLAB_PORT=1234
# How long to wait after the last edit before storing a document's Yjs state (ms).
COLLAB_DEBOUNCE_MS=2000

# ── Monitoring (infra/k8s/monitoring) ──
# Optional: backend /metrics also needs X-Metrics-Token (in addition to Firebase auth);
# collab /metrics uses Authorization: Bearer <token>.
METRICS_TOKEN=

# ── Feature flags (docs/feature-flags.md) ──
# Remote Config is the normal source. These optional overrides are for local development:
# VITE_FLAG_<NAME> for the website, FLAG_<NAME> for the backend. Example:
# VITE_FLAG_YJS_ENABLED=true
# FLAG_AI_DETECTION_ENABLED=false

# ── Tests only (set automatically by `firebase emulators:exec`; don't set in .env) ──
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
# GCLOUD_PROJECT=demo-peerlytics
