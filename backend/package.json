{
  "name": "peerlytics-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint . --ext .js",
    "test": "node --test app.test.js \"config/**/*.test.js\" \"services/**/*.test.js\" \"src/**/*.test.js\"",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=coverage/junit.xml --test-reporter=lcov --test-reporter-destination=coverage/lcov.info app.test.js \"config/**/*.test.js\" \"services/**/*.test.js\" \"src/**/*.test.js\"",
    "test:db": "node --env-file-if-exists=../.env --test --test-concurrency=1 \"db/**/*.itest.js\" \"src/**/*.pg.itest.js\"",
    "test:mail": "node scripts/test-mail.js",
    "migrate": "node-pg-migrate --migrations-dir db/migrations --migrations-table pgmigrations --envPath ../.env",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create --migration-file-language js"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.0.0",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
